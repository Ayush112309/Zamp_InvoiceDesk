# Copy this file to ".env" and fill in ONE AI reader (needed for scanned invoices).
# Priority if several are set: Claude > OpenAI-compatible (LLM_*) > Gemini.

# Option A: Groq (or any OpenAI-compatible provider: OpenRouter, OpenAI, Mistral, Ollama)
# The model MUST accept images (a "vision" model).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
#   Groq model names change: list yours with the command in the README
#   OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:      LLM_BASE_URL=http://localhost:11434/v1   (no key; laptop only)

# Option B: Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=

# Option C: Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Other settings
# AI_MODE=auto              # auto: AI only for scans or when the text parser can't read every field
#                           # always: AI reads every invoice (uses far more of your API quota)
# EXTRACTOR=rules            # force the rule-based parser
# STAGE_MIN_SECONDS=0.45     # minimum visible time per stage in the live view
# TODAY=2026-11-05           # freeze "today" for repeatable demos
